APP_MODE=production
NODE_ENV=production
DATABASE_URL=postgres://vstmailer:REPLACE_WITH_STRONG_PASSWORD@db:5432/vstmailer
# Intended host supplied by owner; confirm domain control and HTTPS before deployment.
APP_URL=https://vst.com
API_HOST=0.0.0.0
API_PORT=4010
HOSTED_SENDING_DOMAIN=REPLACE_WITH_PROVISIONED_SENDING_DOMAIN
AUTH_FROM=accounts@REPLACE_WITH_PROVISIONED_AUTH_DOMAIN
TRANSPORT=postal
POSTAL_URL=https://REPLACE_WITH_POSTAL_HOST
POSTAL_API_KEY=
POSTAL_INGRESS_TOKEN=
OPERATOR_TOKEN=
BILLING_CURRENCY=USD
# Commercial billing is intentionally inactive until merchant activation and prices are approved.

# Identity-only OAuth. Register callback: APP_URL/api/auth/oauth/PROVIDER/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Separate authenticated SMTP submission (not the delivery capture inbox).
SMTP_SUBMISSION_ENABLED=false
SMTP_SUBMISSION_HOST=127.0.0.1
SMTP_SUBMISSION_PORT=2587
SMTP_PUBLIC_HOST=localhost
SMTP_TLS_KEY_FILE=
SMTP_TLS_CERT_FILE=
# Only set this to the exact CIDRs of your trusted reverse proxies.
TRUSTED_PROXY_CIDRS=

# Exact verified owner account; empty disables founder administration.
FOUNDER_ADMIN_EMAIL=

# Operator-onboarded Domain Connect providers; empty means manual DNS fallback.
DOMAIN_CONNECT_PROVIDERS={}
