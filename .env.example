APP_MODE=local
NODE_ENV=development
DATABASE_URL=postgres://vstmailer:vstmailer@127.0.0.1:5432/vstmailer
TEST_DATABASE_URL=postgres://vstmailer:vstmailer@127.0.0.1:5432/vstmailer_test
APP_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4010
API_URL=http://127.0.0.1:4010
HOSTED_SENDING_DOMAIN=send.vstmailer.test
AUTH_FROM=accounts@auth.vstmailer.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
TRANSPORT=smtp-local
# Required for production. Never commit these values.
POSTAL_URL=
POSTAL_API_KEY=
POSTAL_INGRESS_TOKEN=
OPERATOR_TOKEN=
# Local seed only; replace before using the seeded account outside this computer.
DEMO_PASSWORD=VSTMailer-local-2026!

# Identity-only OAuth. Register callback: APP_URL/api/auth/oauth/PROVIDER/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Separate authenticated SMTP submission (not the delivery capture inbox).
SMTP_SUBMISSION_ENABLED=false
SMTP_SUBMISSION_HOST=127.0.0.1
SMTP_SUBMISSION_PORT=2587
SMTP_PUBLIC_HOST=localhost
SMTP_TLS_KEY_FILE=
SMTP_TLS_CERT_FILE=
# Only set this to the exact CIDRs of your trusted reverse proxies.
TRUSTED_PROXY_CIDRS=
