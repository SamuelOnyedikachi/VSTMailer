{
  "name": "vstmailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,worker,inbox,web \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:inbox\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "dev:inbox": "tsx watch --env-file-if-exists=.env src/local-inbox.ts",
    "dev:web": "npm run dev --workspace @vstmailer/web",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @vstmailer/web",
    "build": "npm run build --workspace @vstmailer/web",
    "start:api": "tsx --env-file-if-exists=.env src/server.ts",
    "start:worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "verify:local": "tsx --env-file-if-exists=.env scripts/verify-local.ts",
    "test:acceptance": "tsx --env-file-if-exists=.env scripts/load-acceptance.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "nodemailer": "^10.2.1",
    "smtp-server": "^3.16.1",
    "mailparser": "^3.7.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^7.0.3",
    "@types/smtp-server": "^3.5.12",
    "@types/mailparser": "^3.4.6",
    "concurrently": "^9.2.1"
  }
}
